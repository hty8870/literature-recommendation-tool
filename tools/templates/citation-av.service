[Unit]
Description=Literature manuscript local malware scanner
After=clamav-freshclam.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=clamav
Group=citation
Environment=TZ=UTC
RuntimeDirectory=citation-av
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/clamd --config-file=/opt/citation-tool/security/clamd.conf --foreground
Restart=on-failure
RestartSec=20
TimeoutStartSec=120
TimeoutStopSec=30
CPUQuota=75%
MemoryHigh=1000M
MemoryMax=1400M
MemorySwapMax=512M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/citation-av
ReadOnlyPaths=/var/lib/clamav
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0007

[Install]
WantedBy=multi-user.target
